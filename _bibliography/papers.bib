% Add one BibTeX entry per publication, newest first isn't required —
% jekyll-scholar groups and sorts by year automatically.
%
% Supported extra fields (all optional):
%   abbr   -> short venue tag shown on the left (e.g. NeurIPS, ICML)
%   pdf    -> filename in assets/pdf/, or a full https:// URL
%   arxiv  -> arXiv id, e.g. 2401.01234
%   code   -> https:// URL to a code repo
%   html   -> filename in assets/html/, or a full https:// URL, for a project page
%   doi    -> DOI, e.g. 10.1145/xxxxxx

@inproceedings{yourkey2026,
  abbr={VENUE},
  title={[FILL IN] Paper Title},
  author={Zhu, Shuai and Coauthor, Some},
  booktitle={[FILL IN] Conference / Journal Name},
  year={2026},
  arxiv={0000.00000},
  code={https://github.com/your-username/your-repo}
}
