source 'https://rubygems.org'

gem 'jekyll'

group :jekyll_plugins do
    gem 'jekyll-minifier'
    gem 'jekyll-scholar'
    gem 'jekyll-sitemap'
end

group :other_plugins do
    gem 'css_parser'   # used by jekyll-scholar
    gem 'observer'     # used by jekyll-scholar
    gem 'webrick'       # local `jekyll serve`
end
