---
---
<div class="pub-entry" id="{{ entry.key }}">
  <div class="pub-tag">
    {% if entry.abbr %}
      {% if site.data.venues[entry.abbr].url %}
        <a href="{{ site.data.venues[entry.abbr].url }}">{{ entry.abbr }}</a>
      {% else %}
        {{ entry.abbr }}
      {% endif %}
    {% endif %}
  </div>

  <div class="pub-main">
    <div class="pub-title">{{ entry.title }}</div>

    <div class="pub-authors">
      {%- for author in entry.author_array -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_is_self = false -%}
        {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
          {%- assign author_is_self = true -%}
        {%- endif -%}
        {%- unless forloop.first %}, {% endunless -%}
        {%- if author_is_self -%}
          <em>{{ author.first }} {{ author_last_name }}</em>
        {%- else -%}
          {{ author.first }} {{ author_last_name }}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="pub-venue">
      {%- assign proceedings = 'inproceedings,incollection' | split: ',' -%}
      {%- assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' -%}
      {%- if entry.type == 'article' -%}
        {{ entry.journal }}
      {%- elsif proceedings contains entry.type -%}
        {{ entry.booktitle }}
      {%- elsif thesis contains entry.type -%}
        {{ entry.school }}
      {%- endif -%}
      {%- if entry.type == 'article' and entry.year %}, {{ entry.year }}{% endif -%}
    </div>

    <div class="pub-links">
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a href="{{ entry.pdf }}">PDF</a>
        {% else %}
          <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}">PDF</a>
        {% endif %}
      {% endif %}
      {% if entry.arxiv %}<a href="http://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>{% endif %}
      {% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}">DOI</a>{% endif %}
      {% if entry.code %}<a href="{{ entry.code }}">Code</a>{% endif %}
      {% if entry.html %}
        {% if entry.html contains '://' %}
          <a href="{{ entry.html }}">Project</a>
        {% else %}
          <a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}">Project</a>
        {% endif %}
      {% endif %}
      {% if entry.website %}<a href="{{ entry.website }}">Website</a>{% endif %}
    </div>
  </div>
</div>
